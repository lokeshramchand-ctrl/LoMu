#!/usr/bin/env bash
# After a push that changes the Android app, rebuild it and update the phone in place.
# Runs detached so the push is never delayed or blocked; progress is in .git/phone-update.log.
# Enable once per clone:  git config core.hooksPath .githooks
# The phone now updates itself from GitHub Releases (a dev build has no build number and cannot). Opt in with LOMU_ADB_PUSH=1.
[ "${LOMU_ADB_PUSH:-}" = 1 ] || exit 0
zero=0000000000000000000000000000000000000000
touched=0
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  base="$remote_sha"
  [ "$base" = "$zero" ] && base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
  if [ -z "$base" ] || git diff --name-only "$base" "$local_sha" 2>/dev/null | grep -qE '^(app|innertube|gradle)/|^(build|settings)\.gradle\.kts$|^gradle\.properties$|^version\.properties$'; then
    touched=1
  fi
done
if [ "$touched" = 1 ]; then
  root=$(git rev-parse --show-toplevel)
  nohup "$root/scripts/update-phone.sh" >"$root/.git/phone-update.log" 2>&1 </dev/null &
  echo "pre-push: updating the phone in the background (see .git/phone-update.log)"
fi
exit 0
